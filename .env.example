# These are configuration examples, not loaded automatically; export when needed.
MARKET_MEMORY_DB=/workspace/Market_memory_pro/.data/memory.sqlite3
MARKET_MEMORY_PORT=8000
# Hosted deployment: set DATABASE_URL securely, never commit credentials.
# DATABASE_URL=postgresql://... (obtain from Supabase's session pooler)
# PGSSLROOTCERT=/etc/secrets/supabase-ca.crt
# Set these when placing the app behind an HTTPS reverse proxy.
# MARKET_MEMORY_ORIGIN=https://your-app.example.com
# MARKET_MEMORY_SECURE_COOKIE=1
